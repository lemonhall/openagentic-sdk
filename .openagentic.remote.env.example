# Copy this file to .openagentic.remote.env on the control machine only.
# Do not commit the real .openagentic.remote.env file.

RIGHTCODE_BASE_URL=https://api.rightcode.example/v1
RIGHTCODE_API_KEY=replace-with-real-key
TAVILY_API_KEY=replace-with-real-key

# Optional: WebFetch uses Tavily Extract directly for public web pages.
# OPENAGENTIC_WEBFETCH_TAVILY_EXTRACT_DEPTH=advanced

# Optional: on Windows + local k3d, start the WSL relay in
# scripts/k3d_host_proxy_relay.py and then point pod egress at host.k3d.internal.
# HTTP_PROXY=http://host.k3d.internal:17897
# HTTPS_PROXY=http://host.k3d.internal:17897
# NO_PROXY=127.0.0.1,localhost,.svc,.cluster.local
